# Copy to .env and adjust. Never commit real secrets.
PORT=4000
HOST=0.0.0.0
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret
# Optional: enables the LLM layer (Claude). Without it, the deterministic engine answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Comma-separated list of allowed web origins (mobile apps do not need CORS)
CORS_ORIGINS=http://localhost:8081
DATA_DIR=./data
# Seeds demo@kpi.app / demo1234 when not production
SEED_DEMO_USER=true
